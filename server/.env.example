PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/general-shop
# Atlas example: copy the URI from Atlas > Connect > Drivers, then replace its placeholders.
# mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/general-shop?retryWrites=true&w=majority&appName=...
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-this-with-a-strong-password
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
